{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quietsearch",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": {
  "KEY_MODE": "server",
  "SUMMARY_MODEL": "deepseek-flash",
  "CF_ACCESS_TEAM_DOMAIN": "dahaizahuopu.cloudflareaccess.com",
  "CF_ACCESS_AUD": "277ede366c9b50b2ea7a163e927f37e423fffa556ecbc50ef56a2796b35a30a6"
},
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
  "observability": { "enabled": false },
  "send_metrics": false,
}
